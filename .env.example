# Copy to .env (or export) to override defaults. All values are optional.

# Path to the JSON file backing the board store.
# Default: ./data/board.json (in Docker: /app/data/board.json)
# JOBTRACK_DB=/var/lib/jobtrack/board.json

# Container host port for `docker compose up` (compose only, not the app).
# HOST_PORT=18085
